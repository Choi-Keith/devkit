# 应用
NODE_ENV=development
PORT=3000
# 逗号分隔多个来源,或 * 放开
CORS_ORIGIN=*

# 数据库:mysql(默认)或 postgres
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123456
DB_NAME=app
# 仅开发环境建议开启,生产请用 migrations
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis(连不上时自动降级为内存缓存,启动不崩)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 缓存默认 TTL,毫秒
CACHE_TTL=60000

# JWT(生产环境务必替换为强随机值)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 限流:窗口毫秒数 / 窗口内最大请求数
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
